   "source": [
    "def data_story(df: pd.DataFrame) -> list[dict]:\n",
    "    sections = []\n",
    "\n",
    "    # 1. Context\n",
    "    context_prompt = f\"Dataset: {len(df)} students, columns {list(df.columns)}. Write a 2-3 sentence context paragraph.\"\n",
    "    context_txt, _, _ = llm_call(\"You are an academic data storyteller.\", context_prompt)\n",
    "    fig_ctx = px.histogram(df, x=\"CGPA\", title=\"CGPA Distribution\", color_discrete_sequence=COLOR_SEQ)\n",
    "    sections.append({\"title\": \"Context\", \"text\": context_txt, \"figure\": fig_ctx})\n",
    "\n",
    "    # 2. Key findings\n",
    "    dist = df[\"Risk Class\"].value_counts().to_dict()\n",
    "    findings_prompt = f\"Risk class distribution: {dist}. Write key findings as 3 bullet points.\"\n",
    "    findings_txt, _, _ = llm_call(\"You are an academic data storyteller.\", findings_prompt)\n",
    "    risk_counts = df[\"Risk Class\"].value_counts().rename_axis(\"Risk Class\").reset_index(name=\"Students\")\n",
    "    fig_find = px.bar(risk_counts, x=\"Risk Class\", y=\"Students\",\n",
    "                       title=\"Risk Class Breakdown\", color=\"Risk Class\", color_discrete_sequence=COLOR_SEQ)\n",
    "    sections.append({\"title\": \"Key Findings\", \"text\": findings_txt, \"figure\": fig_find})\n",
    "\n",
    "    # 3. Deeper analysis\n",
    "    by_risk = df.groupby(\"Risk Class\")[[\"Attendance\", \"F_Grades\"]].mean().round(2).to_dict()\n",
    "    deep_prompt = f\"By risk class: {by_risk}. Write a deeper analysis paragraph connecting attendance and failures.\"\n",
    "    deep_txt, _, _ = llm_call(\"You are an academic data storyteller.\", deep_prompt)\n",
    "    fig_deep = px.scatter(df, x=\"Attendance\", y=\"F_Grades\", color=\"Risk Class\", trendline=\"ols\",\n",
    "                           title=\"Attendance vs F Grades\", color_discrete_sequence=COLOR_SEQ)\n",
    "    sections.append({\"title\": \"Deeper Analysis\", \"text\": deep_txt, \"figure\": fig_deep})\n",
    "\n",
    "    # 4. Recommendations\n",
    "    rec_prompt = \"Based on the above, write 3-4 concrete, actionable recommendations for academic advisors.\"\n",
    "    rec_txt, _, _ = llm_call(\"You are an academic data storyteller.\", rec_prompt)\n",
    "    fig_rec = px.box(df, x=\"Risk Class\", y=\"Due Amount (BDT)\", title=\"Due Amount by Risk Class\",\n",
    "                      color=\"Risk Class\", color_discrete_sequence=COLOR_SEQ)\n",
    "    sections.append({\"title\": \"Recommendations\", \"text\": rec_txt, \"figure\": fig_rec})\n",
    "\n",
    "    return sections\n",
    "\n",
    "story = data_story(master_df)\n",
    "for s in story:\n",
    "    print(f\"\\n### {s['title']}\\n{s['text']}\\n\")\n",
    "    s[\"figure\"].show()"
   ]
