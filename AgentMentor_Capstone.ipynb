   "source": [
    "import plotly.express as px\n",
    "import plotly.graph_objects as go\n",
    "\n",
    "COLOR_SEQ = px.colors.qualitative.Set2\n",
    "\n",
    "# C2.1 — distribution (box plot)\n",
    "fig1 = px.box(master_df, y=\"CGPA\", points=\"all\", title=\"CGPA Distribution & Outliers\",\n",
    "              color_discrete_sequence=COLOR_SEQ)\n",
    "fig1.show()\n",
    "\n",
    "# C2.2 — bar chart, grouped by risk class\n",
    "# (explicit rename_axis/reset_index(name=...) avoids pandas-version differences\n",
    "#  in what value_counts().reset_index() calls its columns)\n",
    "risk_counts = master_df[\"Risk Class\"].value_counts().rename_axis(\"Risk Class\").reset_index(name=\"Students\")\n",
    "print(risk_counts)\n",
    "fig2 = px.bar(risk_counts, x=\"Risk Class\", y=\"Students\", title=\"Students by Risk Class\",\n",
    "              color=\"Risk Class\", color_discrete_sequence=COLOR_SEQ)\n",
    "fig2.show()\n",
    "\n",
    "# C2.3 — scatter with regression line (CGPA vs Attendance)\n",
    "fig3 = px.scatter(master_df, x=\"Attendance\", y=\"CGPA\", trendline=\"ols\",\n",
    "                   title=\"CGPA vs Attendance (with regression line)\", color=\"Risk Class\",\n",
    "                   color_discrete_sequence=COLOR_SEQ)\n",
    "fig3.show()\n",
    "\n",
    "# C2.4 — correlation heatmap\n",
    "num_cols = [\"CGPA\", \"SGPA Trend\", \"F_Grades\", \"Attendance\", \"Total_Courses\",\n",
    "            \"Due Amount (BDT)\", \"Counselling_Sessions\"]\n",
    "corr = master_df[num_cols].corr().round(2)\n",
    "fig4 = px.imshow(corr, text_auto=True, title=\"Correlation Matrix\", color_continuous_scale=\"RdBu_r\")\n",
    "fig4.show()\n",
    "\n",
    "# C2.5 — sunburst (Risk Class -> Payment Status)\n",
    "fig5 = px.sunburst(master_df, path=[\"Risk Class\", \"Payment Status\"], title=\"Risk Class -> Payment Status\",\n",
    "                    color_discrete_sequence=COLOR_SEQ)\n",
    "fig5.show()\n",
    "\n",
    "# C2.6 — SGPA trend line (per-student, sampled to keep it readable)\n",
    "sem_cols = [c for c in df_sgpa.columns if c not in (\"Student ID\", \"Name\", \"CGPA\")]\n",
    "long_sgpa = df_sgpa.melt(id_vars=[\"Student ID\", \"Name\"], value_vars=sem_cols,\n",
    "                          var_name=\"Semester\", value_name=\"SGPA\").dropna()\n",
    "sample_ids = df_sgpa[\"Student ID\"].sample(min(8, len(df_sgpa)), random_state=1)\n",
    "fig6 = px.line(long_sgpa[long_sgpa[\"Student ID\"].isin(sample_ids)], x=\"Semester\", y=\"SGPA\",\n",
    "               color=\"Name\", title=\"SGPA Trend (sample of students)\", markers=True,\n",
    "               color_discrete_sequence=COLOR_SEQ)\n",
    "fig6.show()"
   ]
  },
