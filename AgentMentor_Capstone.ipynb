    "def auto_visualize(result_df: pd.DataFrame, question: str, override: str = None):\n",
    "    \"\"\"Picks a chart type from the shape of a query result and captions it via the LLM.\"\"\"\n",
    "    chart_type = override\n",
    "    if chart_type is None:\n",
    "        if result_df.shape[1] == 1 and pd.api.types.is_numeric_dtype(result_df.iloc[:, 0]):\n",
    "            chart_type = \"table\"\n",
    "        elif any(pd.api.types.is_datetime64_any_dtype(result_df[c]) for c in result_df.columns):\n",
    "            chart_type = \"line\"\n",
    "        elif result_df.select_dtypes(include=np.number).shape[1] >= 2:\n",
    "            chart_type = \"scatter\"\n",
    "        else:\n",
    "            chart_type = \"bar\"\n",
    "\n",
    "    cols = result_df.columns.tolist()\n",
    "    if chart_type == \"bar\" and len(cols) >= 2:\n",
    "        fig = px.bar(result_df, x=cols[0], y=cols[1], color_discrete_sequence=COLOR_SEQ)\n",
    "    elif chart_type == \"line\" and len(cols) >= 2:\n",
    "        fig = px.line(result_df, x=cols[0], y=cols[1], markers=True, color_discrete_sequence=COLOR_SEQ)\n",
    "    elif chart_type == \"scatter\" and len(cols) >= 2:\n",
    "        fig = px.scatter(result_df, x=cols[0], y=cols[1], color_discrete_sequence=COLOR_SEQ)\n",
    "    else:\n",
    "        fig = go.Figure(data=[go.Table(header=dict(values=cols),\n",
    "                                        cells=dict(values=[result_df[c] for c in cols]))])\n",
    "\n",
    "    caption_prompt = f'Question: \"{question}\". Result columns: {cols}. Write ONE sentence describing what this chart shows.'\n",
    "    caption, _, _ = llm_call(\"You are a data analyst.\", caption_prompt, max_tokens=60)\n",
    "    fig.update_layout(title=caption)\n",
    "    return fig, chart_type, caption\n",
    "\n",
    "result, _ = run_aggregation('\"Risk Class\"', {\"avg_cgpa\": \"AVG(CGPA)\"})\n",
    "fig, ctype, caption = auto_visualize(result, \"average CGPA by risk class\")\n",
    "print(f\"Auto-selected chart type: {ctype}\\nCaption: {caption}\")\n",
    "fig.show()"
   ]
  },
