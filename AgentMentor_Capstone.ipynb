    "def build_master_table(sgpa, results, payment, counselling) -> pd.DataFrame:\n",
    "    \"\"\"A1: merges all 4 sheets to student grain -> the single unified table.\"\"\"\n",
    "    sem_cols = [c for c in sgpa.columns if c not in (\"Student ID\", \"Name\", \"CGPA\")]\n",
    "\n",
    "    def sgpa_trend(row):\n",
    "        vals = [row[c] for c in sem_cols if pd.notna(row.get(c))]\n",
    "        if len(vals) < 2:\n",
    "            return 0.0\n",
    "        return round(float(vals[-1]) - float(vals[0]), 3)\n",
    "\n",
    "    base = sgpa.copy()\n",
    "    base[\"SGPA Trend\"] = base.apply(sgpa_trend, axis=1)\n",
    "\n",
    "    # aggregate Semester Results -> 1 row per student\n",
    "    res_agg = (\n",
    "        results.groupby(\"Student ID\")\n",
    "        .agg(\n",
    "            F_Grades=(\"Grade\", lambda s: int((s == \"F\").sum())),\n",
    "            Total_Courses=(\"Grade\", \"count\"),\n",
    "            Attendance=(\"Attendance\", \"mean\"),\n",
    "        )\n",
    "        .reset_index()\n",
    "    )\n",
    "\n",
    "    # Payment Status is already 1 row per student\n",
    "    pay_cols = [\"Student ID\", \"Total Payable (BDT)\", \"Total Paid (BDT)\", \"Due Amount (BDT)\", \"Status\"]\n",
    "    pay_slim = payment[pay_cols].rename(columns={\"Status\": \"Payment Status\"})\n",
    "\n",
    "    # aggregate Counselling Log -> counts + latest note per student\n",
    "    couns_agg = (\n",
    "        counselling.sort_values(\"Date\")\n",
    "        .groupby(\"Student ID\")\n",
    "        .agg(\n",
    "            Counselling_Sessions=(\"Date\", \"count\"),\n",
    "            Latest_Counselling_Topic=(\"Topic\", \"last\"),\n",
    "            Latest_Counselling_Remarks=(\"Remarks\", \"last\"),\n",
    "        )\n",
    "        .reset_index()\n",
    "    )\n",
    "\n",
    "    master = (\n",
    "        base.merge(res_agg, on=\"Student ID\", how=\"left\")\n",
    "        .merge(pay_slim, on=\"Student ID\", how=\"left\")\n",
    "        .merge(couns_agg, on=\"Student ID\", how=\"left\")\n",
    "    )\n",
    "\n",
    "    # Missing flag: any critical field absent\n",
    "    critical = [\"CGPA\", \"Attendance\", \"Due Amount (BDT)\"]\n",
    "    master[\"Missing\"] = master[critical].isna().any(axis=1)\n",
    "\n",
    "    # simple rule-based Risk Class (documented; swap for the SVM classifier if you have it loaded)\n",
    "    def risk(row):\n",
    "        if row[\"CGPA\"] < 2.0 or row[\"F_Grades\"] >= 2:\n",
    "            return \"VERY LOW\"\n",
    "        if row[\"CGPA\"] < 2.5 or (row[\"Attendance\"] is not None and row[\"Attendance\"] < 70):\n",
    "            return \"LOW\"\n",
    "        if row[\"CGPA\"] < 3.25:\n",
    "            return \"MODERATE\"\n",
    "        return \"GOOD\"\n",
    "\n",
    "    master[\"Risk Class\"] = master.apply(risk, axis=1)\n",
    "    return master\n",
    "\n",
    "master_df = build_master_table(df_sgpa, df_results, df_payment, df_counselling)\n",
    "print(f\ Master table: {master_df.shape[0]} students x {master_df.shape[1]} columns\")\n",
    "master_df.head(3)"
   ]
  },
