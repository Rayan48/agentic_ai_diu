    "def inspect_schema(df: pd.DataFrame, name: str) -> dict:\n",
    "    \"\"\"Schema-inspection module used both for docs and as LLM context (Task B1).\"\"\"\n",
    "    schema = {\"table\": name, \"n_rows\": len(df), \"n_cols\": df.shape[1], \"columns\": {}}\n",
    "    for col in df.columns:\n",
    "        schema[\"columns\"][col] = {\n",
    "            \"dtype\": str(df[col].dtype),\n",
    "            \"n_unique\": int(df[col].nunique()),\n",
    "            \"n_null\": int(df[col].isna().sum()),\n",
    "            \"sample_values\": df[col].dropna().unique()[:3].tolist(),\n",
    "        }\n",
    "    return schema\n",
    "\n",
    "SCHEMA = {\n",
    "    \"SGPA Trends\": inspect_schema(df_sgpa, \"SGPA Trends\"),\n",
    "    \"Semester Results\": inspect_schema(df_results, \"Semester Results\"),\n",
    "    \"Payment Status\": inspect_schema(df_payment, \"Payment Status\"),\n",
    "    \"Counselling Log\": inspect_schema(df_counselling, \"Counselling Log\"),\n",
    "}\n",
    "print(json.dumps(SCHEMA[\"Payment Status\"], indent=2, default=str))"
   ]
