    "def profile_data(df: pd.DataFrame) -> dict:\n",
    "    report = {\"n_rows\": len(df), \"duplicate_rows\": int(df.duplicated().sum()), \"columns\": {}}\n",
    "    for col in df.select_dtypes(include=[np.number]).columns:\n",
    "        s = df[col].dropna()\n",
    "        if s.empty:\n",
    "            continue\n",
    "        q1, q3 = s.quantile(0.25), s.quantile(0.75)\n",
    "        iqr = q3 - q1\n",
    "        outliers = int(((s < q1 - 1.5 * iqr) | (s > q3 + 1.5 * iqr)).sum())\n",
    "        report[\"columns\"][col] = {\n",
    "            \"missing_pct\": round(df[col].isna().mean() * 100, 2),\n",
    "            \"outlier_count_iqr\": outliers,\n",
    "            \"mean\": round(float(s.mean()), 3),\n",
    "            \"std\": round(float(s.std()), 3),\n",
    "        }\n",
    "    return report\n",
    "\n",
    "QUALITY_REPORT = profile_data(master_df)\n",
    "print(json.dumps(QUALITY_REPORT, indent=2))\n",
    "\n",
    "# Two cleaning steps:\n",
    "# 1) clip Attendance to [0,100] (data-entry errors)\n",
    "master_df[\"Attendance\"] = master_df[\"Attendance\"].clip(0, 100)\n",
    "# 2) standardise Payment Status text casing\n",
    "master_df[\"Payment Status\"] = master_df[\"Payment Status\"].astype(str).str.strip().str.title()\n",
    "print(\" Cleaning applied: Attendance clipped to [0,100], Payment Status casing standardised\")"
   ]
