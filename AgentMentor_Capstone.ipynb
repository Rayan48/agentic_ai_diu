   "source": [
    "def ask_with_context(question: str) -> str:\n",
    "    history_txt = \"\\n\".join(f\"Q: {q}\\nA: {a}\" for q, a in CONVO_HISTORY[-5:])\n",
    "    prompt = f\"Conversation so far:\\n{history_txt}\\n\\nNew question: {question}\\nAnswer using the prior context where relevant.\"\n",
    "    answer, _, _ = llm_call(SYSTEM_PROMPT, prompt)\n",
    "    CONVO_HISTORY.append((question, answer))\n",
    "    if len(CONVO_HISTORY) > 5:\n",
    "        CONVO_HISTORY.pop(0)\n",
    "    return answer\n",
    "\n",
    "def reset_session():\n",
    "    CONVO_HISTORY.clear()\n",
    "    print(\" Session context cleared\")\n",
    "\n",
    "a1 = ask_with_context(\"Which risk class has the highest average CGPA?\")\n",
    "a2 = ask_with_context(\"And what about their average attendance?\")  # follow-up referencing \"their\" = prior group\n",
    "print(\"Turn 1:\", a1[:200], \"\\n\\nTurn 2 (follow-up):\", a2[:200])"
   ]
  },
