      "We have identified three students who are statistical CGPA outliers, meaning their cumulative grade point average (CGPA) is significantly higher than their peers. Despite their academic performance, these students exhibit concerning trends in other areas, warranting attention and potential intervention.\n",
      "\n",
      "**Common Themes:**\n",
      "\n",
      "1. **Low Attendance**: All three student\n"
     ]
    }
   ],
   "source": [
    "def generate_dataset_overview(df: pd.DataFrame) -> str:\n",
    "    stats = df[\"CGPA\"].describe().to_dict()\n",
    "    dist = df[\"Risk Class\"].value_counts().to_dict()\n",
    "    prompt = f\"Summary stats: {stats}\\nRisk distribution: {dist}\\nWrite a Markdown dataset overview report.\"\n",
    "    text, _, _ = llm_call(\"You are an academic data analyst.\", prompt)\n",
    "    return text\n",
    "\n",
    "def generate_trend_comparison(df: pd.DataFrame) -> str:\n",
    "    by_risk = df.groupby(\"Risk Class\")[[\"CGPA\", \"Attendance\"]].mean().round(2).to_dict()\n",
    "    prompt = f\"Compare these groups and comment on the pattern: {by_risk}\"\n",
    "    text, _, _ = llm_call(\"You are an academic data analyst.\", prompt)\n",
    "    return text\n",
    "\n",
    "def generate_anomaly_report(df: pd.DataFrame, vector_store: SimpleVectorStore) -> str:\n",
    "    q1, q3 = df[\"CGPA\"].quantile([0.25, 0.75])\n",
    "    iqr = q3 - q1\n",
    "    anomalies = df[(df[\"CGPA\"] < q1 - 1.5 * iqr) | (df[\"CGPA\"] > q3 + 1.5 * iqr)]\n",
    "    context = []\n",
    "    for _, row in anomalies.iterrows():\n",
    "        hits = vector_store.query(f\"student like {row['Student ID']}\", top_k=1)\n",
    "        context.append(hits[0][\"profile\"] if hits else \"\")\n",
    "    prompt = f\"These students are statistical CGPA outliers:\\n\" + \"\\n\".join(context) + \\\n",
    "             \"\\nExplain, in business terms, what might be going on and flag anyone needing escalation.\"\n",
    "    text, _, _ = llm_call(\"You are a student-welfare data analyst.\", prompt)\n",
    "    return text\n",
    "\n",
    "print(\"Preset 1 — Dataset Overview:\\n\", generate_dataset_overview(master_df)[:400], \"\\n\")\n",
    "print(\"Preset 2 — Trend/Comparison:\\n\", generate_trend_comparison(master_df)[:400], \"\\n\")\n",
    "print(\"Preset 3 — Anomaly Report:\\n\", generate_anomaly_report(master_df, vector_store)[:400])"
   ]
  },
