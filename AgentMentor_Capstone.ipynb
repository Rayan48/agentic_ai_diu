   "cell_type": "markdown",
   "id": "843b99e2",
   "metadata": {},
   "source": [
    "### B2 — Text-to-code pipeline (generate → sandboxed execute → format), with 1 auto-retry"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "bcc3a5e0",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "{\n",
      "  \"question\": \"Which risk class has the highest average CGPA?\",\n",
      "  \"code\": \"master_df.groupby('Risk Class')['CGPA'].mean().idxmax()\\n\",\n",
      "  \"success\": true,\n",
      "  \"answer\": \"### Result Analysis\\nThe result indicates that the **LOW** risk class has the highest average CGPA. This suggests that students with lower risk factors tend to perform better academically. Overall, the data implies a negative correlation between risk level and academic performance.\"\n",
      "}\n"
     ]
    }
   ],
   "source": [
    "def execute_sandboxed(code_str: str, local_vars: dict) -> tuple[bool, object]:\n",
    "    forbidden = [r\"\\bimport\\b\", r\"\\bexec\\b\", r\"\\beval\\b\", r\"\\bopen\\b\",\n",
    "                 r\"\\bos\\b\", r\"\\bsys\\b\", r\"\\bsubprocess\\b\", r\"\\brequests\\b\", r\"__\\w+__\"]\n",
    "    for pat in forbidden:\n",
    "        if re.search(pat, code_str):\n",
    "            return False, f\"Security violation: forbidden pattern '{pat}'\"\n",
    "    safe_builtins = {\"len\": len, \"sum\": sum, \"max\": max, \"min\": min, \"round\": round,\n",
    "                      \"sorted\": sorted, \"list\": list, \"dict\": dict, \"str\": str, \"float\": float, \"int\": int}\n",
    "    try:\n",
    "        result = eval(code_str, {\"__builtins__\": safe_builtins, \"pd\": pd, \"np\": np}, local_vars)\n",
    "        return True, result\n",
    "    except Exception as e:\n",
    "        return False, str(e)\n",
    "\n",
    "def llm_call(system_prompt: str, user_message: str, max_tokens: int = 500) -> tuple[str, float, str]:\n",
    "    \"\"\"Returns (text, elapsed_seconds, finish_reason). Falls back to a placeholder if no client.\"\"\"\n",
    "    t0 = time.perf_counter()\n",
    "    if groq_client is None:\n",
    "        return \"[LLM unavailable — GROQ_API_KEY not set]\", 0.0, \"no_client\"\n",
    "    try:\n",
    "        resp = groq_client.chat.completions.create(\n",
    "            model=LLM_MODEL, max_tokens=max_tokens, temperature=0.1,\n",
    "            messages=[{\"role\": \"system\", \"content\": system_prompt},\n",
    "                      {\"role\": \"user\", \"content\": user_message}],\n",
    "        )\n",
    "        elapsed = time.perf_counter() - t0\n",
    "        choice = resp.choices[0]\n",
    "        LLM_CALL_LOG.append({\"prompt\": user_message, \"elapsed_s\": round(elapsed, 2),\n",
    "                              \"finish_reason\": choice.finish_reason})\n",
    "        return choice.message.content.strip(), elapsed, choice.finish_reason\n",
    "    except Exception as e:\n",
    "        return f\"[LLM error: {str(e)[:150]}]\", time.perf_counter() - t0, \"error\"\n",
    "\n",
    "def nl_query_pipeline(question: str, retry_on_error: bool = True) -> dict:\n",
    "    # Phase 1: code generation\n",
    "    code_str, _, _ = llm_call(SYSTEM_PROMPT, question)\n",
    "    code_str = code_str.strip().strip(\"`\").replace(\"python\\n\", \"\")\n",
    "\n",
    "    # Phase 2: sandboxed execution\n",
    "    ok, result = execute_sandboxed(code_str, {\"master_df\": master_df})\n",
    "    if not ok and retry_on_error:\n",
    "        fix_prompt = f\"The code `{code_str}` raised: {result}. Return a corrected single pandas expression only.\"\n",
    "        code_str2, _, _ = llm_call(SYSTEM_PROMPT, fix_prompt)\n",
    "        code_str2 = code_str2.strip().strip(\"`\").replace(\"python\\n\", \"\")\n",
    "        ok, result = execute_sandboxed(code_str2, {\"master_df\": master_df})\n",
    "        code_str = code_str2 if ok else code_str\n",
    "\n",
    "    # Phase 3: formatting\n",
    "    if ok:\n",
    "        format_prompt = f'Question: \"{question}\"\\nResult: {result}\\nWrite a 1-3 sentence Markdown answer.'\n",
    "        answer, _, _ = llm_call(\"You are a helpful data analyst.\", format_prompt)\n",
    "    else:\n",
    "        answer = f\ Could not answer after retry: {result}\"\n",
    "\n",
    "    return {\"question\": question, \"code\": code_str, \"success\": ok, \"raw_result\": result, \"answer\": answer}\n",
    "\n",
    "demo = nl_query_pipeline(\"Which risk class has the highest average CGPA?\")\n",
    "print(json.dumps({k: v for k, v in demo.items() if k != \"raw_result\"}, indent=2, default=str))"
   ]
  },
