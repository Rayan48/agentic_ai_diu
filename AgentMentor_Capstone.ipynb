   "source": [
    "SYNONYMS = {\n",
    "    \"gpa\": \"CGPA\", \"grade point average\": \"CGPA\",\n",
    "    \"revenue\": None,  # not applicable to this dataset — kept to show the mapping is dataset-specific\n",
    "    \"balance\": \"Due Amount (BDT)\", \"outstanding\": \"Due Amount (BDT)\", \"unpaid\": \"Due Amount (BDT)\",\n",
    "    \"sessions\": \"Counselling_Sessions\", \"counselor visits\": \"Counselling_Sessions\",\n",
    "    \"failures\": \"F_Grades\", \"fails\": \"F_Grades\",\n",
    "    \"presence\": \"Attendance\", \"class attendance\": \"Attendance\",\n",
    "}\n",
    "\n",
    "def build_system_prompt(master_df: pd.DataFrame) -> str:\n",
    "    schema_txt = \"\\n\".join(f\"- {c} ({master_df[c].dtype})\" for c in master_df.columns)\n",
    "    syn_txt = \"\\n\".join(f\"  '{k}' -> '{v}'\" for k, v in SYNONYMS.items() if v)\n",
    "    return f\"\"\"You are a data analyst assistant for a student-mentoring dataset held in a pandas\n",
    "DataFrame called `master_df` with columns:\n",
    "{schema_txt}\n",
    "\n",
    "Synonym mapping for informal phrasing:\n",
    "{syn_txt}\n",
    "\n",
    "When asked a question, respond ONLY with a single pandas expression (no imports, no I/O,\n",
    "no assignment) that computes the answer from `master_df`. Do not explain, just return the code.\"\"\"\n",
    "\n",
    "SYSTEM_PROMPT = build_system_prompt(master_df)\n",
    "\n",
    "# demonstrate column resolution across 10 varied phrasings\n",
    "TEST_PHRASINGS = [\n",
    "    \"who has the lowest GPA\", \"which students owe money\", \"average class presence per risk class\",\n",
    "    \"students with 2+ fails\", \"who saw the counselor most\", \"students behind on payment\",\n",
    "    \"CGPA distribution\", \"attendance below 70\", \"SGPA improving students\", \"top 5 by grade point average\",\n",
    "]\n",
    "for p in TEST_PHRASINGS:\n",
    "    hits = [SYNONYMS[k] for k in SYNONYMS if k in p.lower() and SYNONYMS[k]]\n",
    "    print(f\"{p!r:45s} -> resolves toward: {hits or ['(direct column match expected)']}\")"
   ]
