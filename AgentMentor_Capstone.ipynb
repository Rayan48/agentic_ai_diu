    "from fpdf import FPDF\n",
    "from docx import Document\n",
    "from docx.shared import Pt\n",
    "\n",
    "def export_pdf(narrative: str, filters: dict, filename=\"ai_report.pdf\"):\n",
    "    pdf = FPDF()\n",
    "    pdf.add_page()\n",
    "    pdf.set_font(\"Helvetica\", \"B\", 14)\n",
    "    pdf.cell(0, 10, \"AgentMentor AI Analysis Report\", ln=True)\n",
    "    pdf.set_font(\"Helvetica\", \"\", 10)\n",
    "    pdf.cell(0, 8, f\"Generated: {datetime.now().isoformat(timespec='seconds')}\", ln=True)\n",
    "    pdf.cell(0, 8, f\"Dataset: {len(master_df)} students | Filters: {filters}\", ln=True)\n",
    "    pdf.ln(4)\n",
    "    pdf.set_font(\"Helvetica\", \"\", 11)\n",
    "    pdf.multi_cell(0, 6, narrative.encode(\"latin-1\", \"replace\").decode(\"latin-1\"))\n",
    "    pdf.output(filename)\n",
    "    return filename\n",
    "\n",
    "def export_docx(narrative: str, filters: dict, table_df: pd.DataFrame = None, filename=\"ai_report.docx\"):\n",
    "    doc = Document()\n",
    "    doc.add_heading(\"AgentMentor AI Analysis Report\", level=1)\n",
    "    doc.add_paragraph(f\"Generated: {datetime.now().isoformat(timespec='seconds')}\")\n",
    "    doc.add_paragraph(f\"Dataset: {len(master_df)} students | Filters: {filters}\")\n",
    "    doc.add_heading(\"Narrative\", level=2)\n",
    "    doc.add_paragraph(narrative)\n",
    "    if table_df is not None and not table_df.empty:\n",
    "        doc.add_heading(\"Data\", level=2)\n",
    "        table = doc.add_table(rows=1, cols=len(table_df.columns))\n",
    "        for i, c in enumerate(table_df.columns):\n",
    "            table.rows[0].cells[i].text = str(c)\n",
    "        for _, row in table_df.iterrows():\n",
    "            cells = table.add_row().cells\n",
    "            for i, v in enumerate(row):\n",
    "                cells[i].text = str(v)\n",
    "    doc.save(filename)\n",
    "    return filename\n",
    "\n",
    "def export_chart_png(fig, filename=\"chart.png\"):\n",
    "    fig.write_image(filename)  # requires kaleido\n",
    "    return filename\n",
    "\n",
    "pdf_path = export_pdf(a1, {\"note\": \"demo export\"})\n",
    "docx_path = export_docx(a1, {\"note\": \"demo export\"}, result)\n",
    "print(f\"✅ Exported: {pdf_path}, {docx_path}\")"
   ]
  },
