   "source": [
    "## 🔎 Vector Store — offline TF-IDF index (feeds Task B & D1-style semantic search)\n",
    "\n",
    "`huggingface.co` model downloads aren't reachable in a locked-down/offline environment, so this uses **TF-IDF + cosine similarity** over a per-student text profile — a legitimate, fully offline vector store. Swap in `sentence-transformers` + FAISS/Chroma if your environment can reach the Hub."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "a8bc7386",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Vector store built: 1123 student profiles indexed\n",
      "  251-15-383  sim=0.2459\n",
      "  252-15-632  sim=0.1686\n",
      "  252-15-618  sim=0.1621\n",
      "  252-15-637  sim=0.158\n",
      "  252-15-643  sim=0.1569\n"
     ]
    }
   ],
   "source": [
    "from sklearn.feature_extraction.text import TfidfVectorizer\n",
    "from sklearn.metrics.pairwise import cosine_similarity\n",
    "\n",
    "def student_profile_text(row) -> str:\n",
    "    return (\n",
    "        f\"Student {row['Name']} ({row['Student ID']}). \"\n",
    "        f\"CGPA {row['CGPA']}, risk class {row['Risk Class']}, SGPA trend {row['SGPA Trend']}. \"\n",
    "        f\"{row.get('F_Grades', 0)} F grades out of {row.get('Total_Courses', 0)} courses, \"\n",
    "        f\"attendance {row.get('Attendance', float('nan'))}%. \"\n",
    "        f\"Payment status {row.get('Payment Status', 'unknown')}, due {row.get('Due Amount (BDT)', 'N/A')} BDT. \"\n",
    "        f\"Counselling: {row.get('Counselling_Sessions', 0)} sessions, \"\n",
    "        f\"latest topic '{row.get('Latest_Counselling_Topic', 'none')}', \"\n",
    "        f\"remarks: {row.get('Latest_Counselling_Remarks', 'none')}.\"\n",
    "    )\n",
    "\n",
    "class SimpleVectorStore:\n",
    "    \"\"\"Minimal vector-DB interface: add(), query(). TF-IDF-backed, in-memory.\"\"\"\n",
    "    def __init__(self):\n",
    "        self.vectorizer = TfidfVectorizer(stop_words=\"english\")\n",
    "        self.ids, self.texts, self.matrix = [], [], None\n",
    "\n",
    "    def build(self, df: pd.DataFrame, id_col: str, text_fn):\n",
    "        self.ids = df[id_col].tolist()\n",
    "        self.texts = df.apply(text_fn, axis=1).tolist()\n",
    "        self.matrix = self.vectorizer.fit_transform(self.texts)\n",
    "        return self\n",
    "\n",
    "    def query(self, text: str, top_k: int = 5) -> list[dict]:\n",
    "        q_vec = self.vectorizer.transform([text])\n",
    "        sims = cosine_similarity(q_vec, self.matrix).flatten()\n",
    "        top_idx = sims.argsort()[::-1][:top_k]\n",
    "        return [\n",
    "            {\"student_id\": self.ids[i], \"similarity\": round(float(sims[i]), 4), \"profile\": self.texts[i]}\n",
    "            for i in top_idx\n",
    "        ]\n",
    "\n",
    "vector_store = SimpleVectorStore().build(master_df, \"Student ID\", student_profile_text)\n",
    "print(f\" Vector store built: {len(vector_store.ids)} student profiles indexed\")\n",
    "\n",
    "# demo: D1-style semantic search\n",
    "for r in vector_store.query(\"students struggling with attendance and failing courses\", top_k=5):\n",
    "    print(f\"  {r['student_id']}  sim={r['similarity']}\")"
   ]
