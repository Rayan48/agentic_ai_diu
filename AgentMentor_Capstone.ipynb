     "text": [
      "SGPA Trends     : (1123, 11)\n",
      "Semester Results: (14727, 19)\n",
      "Payment Status  : (1123, 6)\n",
      "Counselling Log : (1957, 7)\n"
     ]
    }
   ],
   "source": [
    "EXCEL_PATH = r\"C:\\\\DIU_MSC\\\\MMS\\\\DL\\\\DIU_MMS_64_I_OFFline.xlsx\"  # <-- update to your local path\n",
    "\n",
    "def load_sheets(path):\n",
    "    sgpa        = pd.read_excel(path, sheet_name=\"SGPA Trends\")\n",
    "    results     = pd.read_excel(path, sheet_name=\"Semester Results\")\n",
    "    payment     = pd.read_excel(path, sheet_name=\"Payment Status\")\n",
    "    counselling = pd.read_excel(path, sheet_name=\"Counselling Log\")\n",
    "    return sgpa, results, payment, counselling\n",
    "\n",
    "try:\n",
    "    df_sgpa, df_results, df_payment, df_counselling = load_sheets(EXCEL_PATH)\n",
    "    print(f\"SGPA Trends     : {df_sgpa.shape}\")\n",
    "    print(f\"Semester Results: {df_results.shape}\")\n",
    "    print(f\"Payment Status  : {df_payment.shape}\")\n",
    "    print(f\"Counselling Log : {df_counselling.shape}\")\n",
    "except FileNotFoundError:\n",
    "    raise FileNotFoundError(f\"Could not find '{EXCEL_PATH}'. Update EXCEL_PATH to your actual file location.\")"
   ]
