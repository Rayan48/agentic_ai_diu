    "duckdb.register(\"students\", master_df)\n",
    "\n",
    "def run_aggregation(group_by: str, metrics: dict) -> tuple[pd.DataFrame, float]:\n",
    "    \"\"\"Direct aggregation query mode. metrics: {alias: 'AGG(col)'} e.g. {'avg_cgpa':'AVG(CGPA)'}.\"\"\"\n",
    "    t0 = time.perf_counter()\n",
    "    metric_sql = \", \".join(f\"{expr} AS {alias}\" for alias, expr in metrics.items())\n",
    "    q = f\"SELECT {group_by}, {metric_sql}, COUNT(*) AS n FROM students GROUP BY {group_by} ORDER BY n DESC\"\n",
    "    result = duckdb.sql(q).df()\n",
    "    return result, round((time.perf_counter() - t0) * 1000, 2)\n",
    "\n",
    "def run_filtered_query(filters: str, group_by: str = None, metrics: dict = None) -> tuple[pd.DataFrame, float]:\n",
    "    \"\"\"Filtered query mode. filters: raw SQL WHERE clause, e.g. \\\"CGPA < 2.5 AND \\\\\\\"F_Grades\\\\\\\" > 0\\\".\"\"\"\n",
    "    t0 = time.perf_counter()\n",
    "    if group_by and metrics:\n",
    "        metric_sql = \", \".join(f\"{expr} AS {alias}\" for alias, expr in metrics.items())\n",
    "        q = f\"SELECT {group_by}, {metric_sql}, COUNT(*) AS n FROM students WHERE {filters} GROUP BY {group_by}\"\n",
    "    else:\n",
    "        q = f\"SELECT * FROM students WHERE {filters}\"\n",
    "    result = duckdb.sql(q).df()\n",
    "    return result, round((time.perf_counter() - t0) * 1000, 2)\n",
    "\n",
    "res, ms = run_aggregation('\"Risk Class\"', {\"avg_cgpa\": \"AVG(CGPA)\", \"avg_attendance\": \"AVG(Attendance)\"})\n",
    "print(f\"Query time: {ms} ms\")\n",
    "res"
   ]
  },
