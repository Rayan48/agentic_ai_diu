    "def validate_response(text: str, finish_reason: str) -> str:\n",
    "    if not text or not text.strip():\n",
    "        return \"empty\"\n",
    "    if finish_reason == \"length\":\n",
    "        return \"truncated\"\n",
    "    if finish_reason == \"error\":\n",
    "        return \"error\"\n",
    "    return \"ok\"\n",
    "\n",
    "BENCHMARK_QUESTIONS = [\n",
    "    \"Which risk class has the highest average CGPA?\",\n",
    "    \"How many students have 2 or more F grades?\",\n",
    "    \"What is the average attendance for students with overdue payments?\",\n",
    "    \"List the 3 students with the lowest CGPA.\",\n",
    "    \"Which students have had more than 2 counselling sessions?\",\n",
    "]\n",
    "\n",
    "bench_rows = []\n",
    "for q in BENCHMARK_QUESTIONS:\n",
    "    t0 = time.time()\n",
    "    r = nl_query_pipeline(q)\n",
    "    elapsed = round(time.time() - t0, 2)\n",
    "    status = validate_response(r[\"answer\"], \"ok\" if r[\"success\"] else \"error\")\n",
    "    bench_rows.append({\"question\": q, \"success\": r[\"success\"], \"elapsed_s\": elapsed, \"status\": status})\n",
    "\n",
    "bench_df = pd.DataFrame(bench_rows)\n",
    "print(f\"Accuracy on benchmark: {bench_df['success'].mean()*100:.0f}%\")\n",
    "bench_df"
   ]
  },
