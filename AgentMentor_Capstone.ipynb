   "source": [
    "TOOLS = {\n",
    "    \"query_data\": lambda args: nl_query_pipeline(args[\"question\"])[\"answer\"],\n",
    "    \"visualize\": lambda args: auto_visualize(*run_aggregation(args[\"group_by\"], {\"avg_cgpa\": \"AVG(CGPA)\"})[:1], args[\"question\"])[2],\n",
    "    \"vector_search\": lambda args: vector_store.query(args[\"query\"], top_k=args.get(\"top_k\", 3)),\n",
    "}\n",
    "\n",
    "REACT_SYSTEM = \"\"\"You are a ReAct-style planning agent with 3 tools:\n",
    "- query_data(question): answers a data question via the NL query pipeline\n",
    "- visualize(question, group_by): builds a chart, returns its caption\n",
    "- vector_search(query, top_k): semantic search over student profiles\n",
    "\n",
    "Given a user request, respond with STRICT JSON: {\"thought\": \"...\", \"action\": \"tool_name\", \"action_input\": {...}}\n",
    "or, if you already have the final answer, {\"thought\": \"...\", \"action\": \"final_answer\", \"action_input\": {\"answer\": \"...\"}}.\"\"\"\n",
    "\n",
    "def react_agent(user_request: str, max_steps: int = 4) -> dict:\n",
    "    debug_panel = []\n",
    "    scratchpad = f\"User request: {user_request}\"\n",
    "    for step in range(max_steps):\n",
    "        raw, _, _ = llm_call(REACT_SYSTEM, scratchpad, max_tokens=300)\n",
    "        try:\n",
    "            parsed = json.loads(raw[raw.find(\"{\"): raw.rfind(\"}\") + 1])\n",
    "        except Exception:\n",
    "            parsed = {\"thought\": \"Could not parse LLM output\", \"action\": \"final_answer\",\n",
    "                       \"action_input\": {\"answer\": raw}}\n",
    "\n",
    "        debug_panel.append({\"step\": step + 1, \"thought\": parsed.get(\"thought\"),\n",
    "                             \"action\": parsed.get(\"action\"), \"action_input\": parsed.get(\"action_input\")})\n",
    "\n",
    "        if parsed.get(\"action\") == \"final_answer\":\n",
    "            return {\"answer\": parsed[\"action_input\"].get(\"answer\"), \"trace\": debug_panel}\n",
    "\n",
    "        tool = TOOLS.get(parsed.get(\"action\"))\n",
    "        observation = tool(parsed.get(\"action_input\", {})) if tool else f\"Unknown tool: {parsed.get('action')}\"\n",
    "        debug_panel[-1][\"observation\"] = str(observation)[:300]\n",
    "        scratchpad += f\"\\nThought: {parsed.get('thought')}\\nAction: {parsed.get('action')}\\nObservation: {observation}\"\n",
    "\n",
    "    return {\"answer\": \"Max steps reached without a final answer.\", \"trace\": debug_panel}\n",
    "\n",
    "result = react_agent(\"Find at-risk students with poor attendance and tell me what stands out.\")\n",
    "print(\"FINAL ANSWER:\", result[\"answer\"])\n",
    "print(\"\\n--- Reasoning chain (debug panel) ---\")\n",
    "for step in result[\"trace\"]:\n",
    "    print(json.dumps(step, indent=2, default=str))"
   ]
  },
