    "import os, re, json, time, warnings, getpass\n",
    "from datetime import datetime\n",
    "from collections import Counter\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import duckdb\n",
    "warnings.filterwarnings(\"ignore\")\n",
    "\n",
    "# ── Groq key: env var / secret manager first, else prompt at runtime ──\n",
    "# Never hardcoded, never printed, never written to disk. getpass hides\n",
    "# the input as you type it (like a terminal password prompt).\n",
    "GROQ_API_KEY = os.environ.get(\"GROQ_API_KEY\", \"\")\n",
    "if not GROQ_API_KEY:\n",
    "    GROQ_API_KEY = getpass.getpass(\"Enter your GROQ_API_KEY (hidden input): \")\n",
    "    os.environ[\"GROQ_API_KEY\"] = GROQ_API_KEY  # so later cells / reruns in this session can reuse it\n",
    "\n",
    "LLM_MODEL = \"llama-3.3-70b-versatile\"\n",
    "\n",
    "try:\n",
    "    from groq import Groq\n",
    "    groq_client = Groq(api_key=GROQ_API_KEY) if GROQ_API_KEY else None\n",
    "    if groq_client:\n",
    "        print(\" Groq client ready\")\n",
    "    else:\n",
    "        print(\" GROQ_API_KEY not set — LLM cells will show a placeholder instead of failing\")\n",
    "except Exception as e:\n",
    "    groq_client = None\n",
    "    print(f\" Groq unavailable: {e}\")\n",
    "\n",
    "CONVO_HISTORY = []   # last 5 (question, answer) turns — used by Task B4\n",
    "LLM_CALL_LOG  = []   # for benchmarking (Task B5)"
   ]
